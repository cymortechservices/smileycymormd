// SMILEY CYMOR MD — settings
// Panel / VPS users: fill ONLY the SESSION line (paste the session ID that starts with "cymor").

# ✅ REQUIRED - your session ID from the SMILEY CYMOR MD pair page (starts with cymor)
SESSION=

# Optional - PostgreSQL URL (leave empty to use the built-in local file database)
DATABASE_URL=

# Owner number(s), international format without + (comma separated for several)
DEV=254113821327
BOTNAME=SMILEY CYMOR MD
CODE=254
PORT=10000

# Optional - link of your pair website, used by the .pair command
# PAIR_URL=https://your-pair-site.onrender.com
# Optional - your GitHub repo (owner/name), used by .repo .zip .update
# GITHUB_REPO=yourname/smiley-cymor-md
# Optional - set to true to auto-follow the SMILEY CYMOR MD USERS channel on connect
# AUTO_FOLLOW_CHANNEL=false
# Optional - Telegram bot token, only needed for the .tg sticker-pack command
# TELEGRAM_BOT_TOKEN=
